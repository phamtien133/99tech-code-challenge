# Every key the configuration schema (src/config/env.ts) knows about.
# All of them have defaults that match docker-compose.yml, so a fresh clone
# runs with no configuration at all. Values below are those defaults.
#
# Copy to .env if you want to change something: `cp .env.example .env`. The step
# is optional - the values below are already the defaults.
#
# Precedence: a real environment variable beats .env, which beats the default.
# `export DB_PORT=5440` or `DB_PORT=5440 npm run dev` therefore still wins.

# development | test | production
NODE_ENV=development

# HTTP port the server listens on
PORT=3000

# PostgreSQL connection (host port published by docker-compose)
DB_HOST=localhost
DB_PORT=5439
DB_USER=postgres
DB_PASSWORD=postgres

# Database used when NODE_ENV is not "test"
DB_NAME=challenge_dev

# Database used when NODE_ENV=test (created by docker/init/01-create-test-db.sql)
TEST_DB_NAME=challenge_test
